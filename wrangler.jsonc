{
	"name": "mini",
	"compatibility_date": "2026-07-24",
	"main": "worker/index.js",
	"assets": {
		"directory": "."
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "mini_ranking",
			"database_name": "mini-ranking",
			"database_id": "b6f68cd8-2118-48e5-9e04-d2b6edb8db37",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "OTHELLO_ROOM", "class_name": "OthelloRoom" },
			{ "name": "CATAN_ROOM", "class_name": "CatanRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OthelloRoom"] },
		{ "tag": "v2", "new_sqlite_classes": ["CatanRoom"] }
	]
}